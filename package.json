{
  "name": "dsh-annotate-anything",
  "version": "0.1.0",
  "private": true,
  "description": "Annotate any part of the Harness UI and send annotated screenshots to the chat.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.cjs",
    "check": "npm run build && npm test && node --check client.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meatware-Engineering/DSH-AnnotateAnything.git"
  }
}
